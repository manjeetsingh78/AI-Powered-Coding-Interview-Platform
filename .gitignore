# ──────────────────────────────────────────────
#  AI Powered Coding Interview Platform
#  .gitignore — covers Frontend (React/Vite) +
#               Backend (Django) + Infra
# ──────────────────────────────────────────────


# ── Node / Frontend ────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Build output
build/
out/
frontend/dist-validate/

# Vite cache
.vite-inspect/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
reports/
playwright-report/
test-results/
*.snap


# ── Environment Variables ──────────────────────
# NEVER commit these — they contain secrets
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# Keep the example files (no secrets inside)
!.env.example


