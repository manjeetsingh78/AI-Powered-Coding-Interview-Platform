# ── Docker ────────────────────────────────────
# Keep Dockerfiles but ignore local overrides
docker-compose.override.yml
.docker/


# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ── Package manager locks ─────────────────────
# Keep ONE lock file — commit whichever your team uses
# If using npm:  keep package-lock.json, ignore others
# If using yarn: keep yarn.lock, ignore others
yarn.lock
pnpm-lock.yaml
# Uncomment below if using yarn instead of npm:
# package-lock.json


# ── Secrets & Keys ────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
.secrets/
credentials.json
service-account.json
firebase-adminsdk*.json


# ── AWS ───────────────────────────────────────
.aws/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
infra/terraform/outputs.json
infra/terraform/tfplan


# ── Misc ──────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
.cache/
tmp/
temp/
scripts/tmp/


# ── Jenkins & CI/CD ───────────────────────────
# Keep: Jenkinsfile (no secrets)
# Ignore: Local Jenkins configs with credentials
jenkins_credentials.xml
jenkins_secrets/
jenkins_plugins_cache/
.jenkins/


# ── SonarQube ─────────────────────────────────
# Keep: sonarqube-config.yaml (example)
# Ignore: Files with actual tokens
sonarqube-*.local.yaml
sonarqube-token*
.sonarqube/


# ── Snyk ──────────────────────────────────────
# Keep: snyk-config.json (example)
# Ignore: Files with actual API keys
.snyk
snyk-token*
snyk-*.local.json
.snyk/


# ── OWASP ZAP ─────────────────────────────────
zap-baseline.html
zap-full-scan.html
zap-report/
.zaprc


# ── Kubernetes & Helm ─────────────────────────
# Keep: deploy/k8s/*.yaml, deploy/helm/
# Ignore: Local kubeconfig, values with secrets
kubeconfig
kubeconfig-*
.kube/
deploy/helm/values-*.local.yaml
deploy/helm/values-secrets.yaml


# ── Terraform & IaC ──────────────────────────
# Keep: *.tf files
# Ignore: State, lock files, tfvars with secrets
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!terraform.tfvars.example
terraform-*.local.tfvars


# ── Monitoring & Observability ───────────────
# Keep: prometheus/, grafana/, datadog/ configs (examples)
# Ignore: Local overrides with credentials
prometheus-local.yml
grafana-*.json
datadog-override.yml
.datadog-agent/