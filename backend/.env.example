# ── REQUIRED ──
# Django secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True only for local development
DEBUG=True

# Comma-separated list of allowed hosts for production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── DATABASE ──
DATABASE_URL=postgresql://user:password@localhost:5432/interview_platform
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30

# ── CACHE & MESSAGE BROKER ──
CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── EMAIL ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@interview-platform.local
ANYMAIL_SENDGRID_API_KEY=

# ── JWT ──
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800
JWT_ALGORITHM=HS256

# ── CODE EXECUTION ──
CODE_EXECUTION_BACKEND=disabled
PISTON_API_URL=
ALLOW_LOCAL_CODE_EXECUTION=False
PISTON_PYTHON_VERSION=3.11.0
PISTON_JAVASCRIPT_VERSION=20.10.0

# ── LOGGING ──
LOG_LEVEL=INFO
LOG_FILE=/var/log/django/app.log

# ── SECURITY ──
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── RATE LIMITING ──
RATELIMIT_ENABLE=True
RATELIMIT_LOGIN_ATTEMPTS=5
RATELIMIT_VERIFICATION_CODE_ATTEMPTS=5

# ── MONITORING & ERROR TRACKING ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── FEATURES ──
ENABLE_SOCIAL_AUTH=False
ENABLE_VIDEO_INTERVIEWS=False
ENABLE_ADMIN_DASHBOARD=True

# ── APPLICATION ──
APP_VERSION=1.0.0
ENVIRONMENT=development

# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted CSRF origins for production and local development
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:5173,http://127.0.0.1:5173

# ── Database ──
DB_NAME=interview_platform_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ── Email (choose one) ──
# SendGrid (recommended for production)
SENDGRID_API_KEY=your_sendgrid_api_key

# OR Brevo SMTP
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password

# Sender email (must be verified in your email provider)
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Optional ──
# JWT token lifetime (minutes/days)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Set to True to allow unverified users to login (useful during development)
ALLOW_UNVERIFIED_LOGIN=False

# ── Code execution ──
# Production: use an isolated executor. Local host execution is intentionally opt-in.
# CODE_EXECUTION_BACKEND=disabled|piston|local
CODE_EXECUTION_BACKEND=disabled
PISTON_API_URL=https://emkc.org
PISTON_PYTHON_VERSION=3.10.0
PISTON_JAVASCRIPT_VERSION=18.15.0
PISTON_CPP_VERSION=10.2.0
PISTON_JAVA_VERSION=15.0.2
PISTON_GO_VERSION=1.16.2

# Development only. Never enable this in production.
ALLOW_LOCAL_CODE_EXECUTION=False
